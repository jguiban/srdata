    {
      "type": "timeseries",
      "title": "Retard sur le leader — $classe",
      "datasource": {
        "type": "influxdb",
        "uid": "influx-flux"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 35
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influx-flux"
          },
          "query": "from(bucket: \"rdr2026\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"report\" and r.class == \"${classe}\" and r._field == \"dtl\")\n\n  |> filter(fn: (r) => contains(value: r.boat, set: ${bateau:json}))\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> keep(columns: [\"_time\", \"_value\", \"boat\"])"
        }
